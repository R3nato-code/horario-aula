rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function mesmoUsuario(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function ehAdministrativo() {
      return autenticado()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'gestor'];
    }

    match /users/{uid} {
      allow get: if mesmoUsuario(uid);
      allow list: if false;
      allow delete: if false;
      allow create: if mesmoUsuario(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'aluno'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
    }

    match /professores/{id} {
      allow read: if autenticado();
      allow write: if ehAdministrativo();
    }
    match /disciplinas/{id} {
      allow read: if autenticado();
      allow write: if ehAdministrativo();
    }
    match /turmas/{id} {
      allow read: if autenticado();
      allow write: if ehAdministrativo();
    }
    match /aulas/{id} {
      allow read: if autenticado();
      allow write: if ehAdministrativo();
    }
    match /configuracao/{id} {
      allow read: if autenticado();
      allow write: if ehAdministrativo();
    }

    match /historico/{id} {
      allow read: if autenticado();
      allow create: if ehAdministrativo();
      allow update: if false;
      allow delete: if false;
    }

    match /salas/{id} { allow read, write: if false; }

    match /notificacoes/{id} {
      allow get, list: if mesmoUsuario(resource.data.uid);
      allow create, delete: if false;
      allow update: if mesmoUsuario(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lida', 'lidaEm'
        ])
        && request.resource.data.lida == true
        && request.resource.data.lidaEm == request.time
        && resource.data.lida == false;
    }

    match /favoritos/{favoritoId} {
      // Permite ler um documento inexistente (necessário para a transação de
      // alternar favorito verificar existência antes de criar). Documentos
      // existentes só podem ser lidos pelo próprio dono.
      allow get: if autenticado()
        && (resource == null || mesmoUsuario(resource.data.uid));
      allow list: if mesmoUsuario(resource.data.uid);
      allow update: if false;
      allow delete: if mesmoUsuario(resource.data.uid);
      allow create: if mesmoUsuario(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'turmaId', 'criadoEm'])
        && favoritoId == request.auth.uid + '_' + request.resource.data.turmaId
        && request.resource.data.turmaId is string
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.criadoEm <= request.time
        && exists(
          /databases/$(database)/documents/turmas/$(request.resource.data.turmaId)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
