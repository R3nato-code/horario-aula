# Modo de dados do front-end: demo (dados locais) ou firebase (serviços reais).
VITE_DATA_MODE=demo

# Configuração PÚBLICA do Firebase (Console > Configurações do projeto).
# Nenhum segredo, service account ou chave de IA pertence ao cliente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Região das Cloud Functions callable. O padrão do backend é southamerica-east1.
VITE_FUNCTIONS_REGION=southamerica-east1
